#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

// Constants
const int MAXN = 100005;
// K is the threshold for precomputed paths. 
// sqrt(10^5) is approx 316. We choose 320 for safety.
const int K = 320; 

// Graph storage: adj[u] contains v such that u -> v
// Since edges go High -> Low, v will always be < u.
vector<int> adj[MAXN];

// Precomputed top-K paths: best_paths[u] stores pairs {length, endpoint}
// Sorted by length descending.
vector<pair<int, int>> best_paths[MAXN];

// Arrays for handling queries
int forbidden_marker[MAXN];
int query_counter = 0;

// Arrays for the heavy solver (ad-hoc DP)
int dp_dist[MAXN];

int main() {
    // Optimize I/O operations
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m, q;
    if (!(cin >> n >> m >> q)) return 0;

    for (int i = 0; i < m; ++i) {
        int e, s;
        cin >> e >> s;
        // Input says: "road from S to E". 
        // Also problem states edges go from Larger to Smaller (S > E).
        adj[s].push_back(e);
    }

    // --- PRECOMPUTATION PHASE ---
    // We compute the K best paths for each node.
    // Since u -> v implies v < u, we can process nodes from 1 to n.
    // When processing u, all its children (v) are already processed.
    
    // Helper vector for merging candidates
    vector<pair<int, int>> candidates;
    candidates.reserve(K * 10); // Reserve some memory to reduce reallocations
    
    // Cookie for uniqueness check in precalc
    vector<int> seen_cookie(n + 1, 0);
    int cookie = 0;

    for (int u = 1; u <= n; ++u) {
        candidates.clear();
        
        // Option 1: The path ends at u (length 0)
        candidates.push_back({0, u});
        
        // Option 2: Extend paths from children
        for (int v : adj[u]) {
            // best_paths[v] is already sorted and computed
            for (const auto& p : best_paths[v]) {
                candidates.push_back({p.first + 1, p.second});
            }
        }

        // Sort candidates by length descending
        // For standard inputs, sorting this aggregated list is efficient enough.
        sort(candidates.begin(), candidates.end(), [](const pair<int,int>& a, const pair<int,int>& b){
            return a.first > b.first;
        });

        // Filter unique endpoints and keep top K
        cookie++; // Increment cookie for new session
        auto& current_best = best_paths[u];
        current_best.reserve(K);
        
        int count = 0;
        for (const auto& p : candidates) {
            // If we haven't seen this endpoint yet in this merge step
            if (seen_cookie[p.second] != cookie) {
                seen_cookie[p.second] = cookie;
                current_best.push_back(p);
                count++;
                if (count == K) break; // We only need top K
            }
        }
    }

    // --- QUERY PHASE ---
    for (int k = 0; k < q; ++k) {
        int t, x;
        cin >> t >> x;
        
        // Read forbidden nodes
        // We use a query_counter to avoid clearing the forbidden array every time.
        query_counter++; 
        for (int i = 0; i < x; ++i) {
            int c;
            cin >> c;
            forbidden_marker[c] = query_counter;
        }

        int ans = -1;
        bool found_in_precalc = false;

        // Try to find the answer in the precomputed top-K list
        for (const auto& p : best_paths[t]) {
            if (forbidden_marker[p.second] != query_counter) {
                ans = p.first;
                found_in_precalc = true;
                break;
            }
        }

        if (found_in_precalc) {
            cout << ans << "\n";
        } else {
            // If we didn't find a valid path in the top K...
            
            // Case 1: The list was exhaustive (size < K), meaning no valid path exists at all.
            if (best_paths[t].size() < K) {
                cout << -1 << "\n";
            } 
            // Case 2: The list was truncated, and all top K paths were blocked.
            // This implies X >= K (or close to it). We must run the heavy solver.
            else {
                // HEAVY SOLVER: Ad-hoc DP for this specific query.
                // We want max(dist[v]) where v is reachable from t and not forbidden.
                // Iterate backwards from t to 1 (topological order).
                
                // Reset DP array for relevant range
                // Note: resetting only up to t is sufficient.
                for (int i = 1; i <= t; ++i) dp_dist[i] = -1;
                
                dp_dist[t] = 0;
                int max_len = -1;
                
                // If start node is valid, it's a candidate for max_len
                if (forbidden_marker[t] != query_counter) {
                    max_len = 0;
                }

                // Process nodes downwards
                for (int u = t; u >= 1; --u) {
                    if (dp_dist[u] == -1) continue;
                    
                    int d = dp_dist[u];
                    
                    // Relax edges
                    for (int v : adj[u]) {
                        if (d + 1 > dp_dist[v]) {
                            dp_dist[v] = d + 1;
                        }
                    }
                    
                    // If u is a valid endpoint, check max
                    // (Note: we check u when we process it as a source, which covers all nodes)
                    // Actually, we need to check endpoints.
                    // The loop processes `u`. We can check if `u` is a valid destination.
                    // However, we just processed `u`'s outgoing edges.
                    // We need to ensure we check `v`'s validity when we update it or after processing?
                    // Better: Check every node i if dp_dist[i] != -1 and !forbidden.
                    // Since we iterate u anyway, we can check inside the loop.
                    // BUT: when we are at u, dp_dist[u] is final.
                    if (forbidden_marker[u] != query_counter) {
                         if (dp_dist[u] > max_len) max_len = dp_dist[u];
                    }
                }
                cout << max_len << "\n";
            }
        }
    }

    return 0;
}
